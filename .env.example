# Copy to .env: cp .env.example .env

# PostgreSQL connection string (matches docker-compose.yml `db` service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoservice

# Auth.js secret — required from FASE 2.5 (min 32 chars).
# Generate: openssl rand -base64 32
# Placeholder below intentionally FAILS validation; replace before booting.
AUTH_SECRET=change-me

# Base URL of the app (default: http://localhost:3000)
APP_URL=http://localhost:3000
