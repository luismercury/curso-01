# Copy to .env: cp .env.example .env

# PostgreSQL connection string (matches docker-compose.yml `db` service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoservice

# Auth.js secret — becomes required at FASE 2.5 (T-050).
# Generate a real secret with: openssl rand -base64 32
# Placeholder below intentionally FAILS validation if used verbatim.
AUTH_SECRET=change-me

# Base URL of the app (default: http://localhost:3000)
APP_URL=http://localhost:3000
